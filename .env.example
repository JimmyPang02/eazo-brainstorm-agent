# Eazo app ID for platform import/runtime metadata.
EAZO_APP_ID=your_eazo_app_id_here

# OpenAI key used only by the server-side Brainstorm Agent route.
# Never expose this in client code or commit a real key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional model override for the Brainstorm Agent.
OPENAI_AGENT_MODEL=gpt-5.5

# Optional timeout (ms) for the Brainstorm Agent API call. Defaults to 90000.
# Vercel `maxDuration` in src/app/api/agent/run/route.ts caps the upper bound.
AGENT_TIMEOUT_MS=90000
