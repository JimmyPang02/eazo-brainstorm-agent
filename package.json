{
  "name": "eazo-brainstorm-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next",
    "check": "bun run clean && bun test && bun run lint && bunx tsc --noEmit && bun run build",
    "check:all": "bun run check && bun run test:e2e",
    "test": "bun test",
    "test:e2e": "playwright test",
    "smoke:openai": "bun scripts/smoke-openai-agent.ts",
    "smoke:ui-openai": "BRAINSTORM_REAL_OPENAI_E2E=1 playwright test tests/idea-tree-real-openai.e2e.ts --project=chromium",
    "lint": "eslint",
    "sdk:sync": "rm -rf node_modules/@eazo/sdk && mkdir -p node_modules/@eazo/sdk && cp ../eazo-sdk/sdk/package.json node_modules/@eazo/sdk/ && cp -r ../eazo-sdk/sdk/dist node_modules/@eazo/sdk/dist && cp -R ../eazo-sdk/sdk/node_modules node_modules/@eazo/sdk/node_modules",
    "sdk:dev": "(cd ../eazo-sdk/sdk && npm run build) && bun run sdk:sync",
    "sdk:watch": "bun run scripts/sdk-watch.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@eazo/sdk": "0.19.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "openai": "^6.39.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
